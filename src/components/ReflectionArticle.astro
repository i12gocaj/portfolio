---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import BookCover from "@/components/BookCover.astro";
import Toc from "@/components/Toc.astro";
import MusicPlayer from "@/components/MusicPlayer.astro";
import Poem from "@/components/Poem.astro";
import { type Lang, route, useTranslations } from "@/i18n/ui";
import {
  formatDate,
  langOf,
  readingMinutes,
  reflectionTranslation,
  reflectionUrl,
  type Reflection,
} from "@/lib/content";

interface Props {
  reflection: Reflection;
}
const { reflection: r } = Astro.props;
const lang: Lang = langOf(r);
const t = useTranslations(lang);
const { data } = r;
const { Content, headings } = await render(r);
const translation = await reflectionTranslation(r);
const other: Lang = lang === "es" ? "en" : "es";
// Sin traducción, el cambio de idioma lleva al listado del otro idioma.
const alternates = {
  [lang]: reflectionUrl(r),
  [other]: translation ? reflectionUrl(translation) : route(other, "reflections"),
} as Record<Lang, string>;
// Una portada apaisada necesita más ancho para verse entera a buen tamaño.
const coverWidth = data.cover && data.cover.width > data.cover.height ? 230 : 140;
---

<BaseLayout
  lang={lang}
  route="reflections"
  alternates={alternates}
  title={data.title}
  description={data.description}
  image={data.cover?.src}
  article
>
  <article class="mx-auto max-w-3xl px-5 pb-24 md:px-8">
    <a href={route(lang, "reflections")} class="meta mt-12 inline-block transition-colors duration-150 hover:text-accent md:mt-16">
      <span aria-hidden="true">←</span>{" "}{t("reflections.back")}
    </a>
    <header class="mt-8 grid items-center gap-7 sm:gap-9" style={`--cover: ${coverWidth}px`}>
      <div class="cover-slot">
        <BookCover tone={data.tone} image={data.cover} video={data.video} alt={data.coverAlt} sizes="220px" eager />
      </div>
      <div>
        <p class="meta flex flex-wrap gap-x-3 gap-y-1">
          {data.kind === "poema" && <span class="!text-accent">{t("reflections.poem")}</span>}
          <time datetime={data.date.toISOString()}>{formatDate(data.date, lang)}</time>
          {data.kind !== "poema" && <span>{readingMinutes(r)} {t("text.min")}</span>}
          {data.draft && <span class="!text-copper">[{t("text.draft")}]</span>}
        </p>
        <h1 class="mt-3 text-[2rem] font-semibold tracking-tight leading-[1.15] text-balance md:text-[2.5rem]">
          {data.title}
        </h1>
        {data.kind !== "poema" && <p class="mt-3 text-lg leading-relaxed text-slate">{data.description}</p>}
      </div>
    </header>

    {
      data.music && (
        <div class="mt-10">
          <MusicPlayer music={data.music} label={t("music.label")} play={t("music.play")} pause={t("music.pause")} />
        </div>
      )
    }

    {
      data.kind === "poema" ? (
        <div class="mt-14">
          <Poem body={r.body ?? ""} />
        </div>
      ) : (
        <>
          <div class="mt-12">
            <Toc headings={headings} label={t("text.contents")} />
          </div>
          <div class="prose mt-10">
            <Content />
          </div>
        </>
      )
    }

    {
      data.tags.length > 0 && (
        <ul class="meta mt-16 flex flex-wrap gap-x-4 gap-y-1 border-t border-line pt-6">
          {data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
  </article>
</BaseLayout>

<style>
  .cover-slot {
    width: calc(var(--cover) * 0.8);
  }
  @media (width >= 40rem) {
    header {
      grid-template-columns: var(--cover) minmax(0, 1fr);
    }
    .cover-slot {
      width: var(--cover);
    }
  }
</style>
