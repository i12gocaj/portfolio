---
import Cover from "@/components/Cover.astro";
import type { Lang } from "@/i18n/ui";
import { coverOf, projectUrl, type Project } from "@/data/content";

interface Props {
  project: Project;
  lang: Lang;
}
const { project: p, lang } = Astro.props;
const href = projectUrl(p, lang) ?? p.links[0]?.href;
---

<article id={p.id} class="group relative scroll-mt-28">
  <Cover id={p.id} tone={p.tone} image={coverOf(p)} alt="" sizes="(min-width: 768px) 300px, 100vw" />
  <div class="mt-5 flex items-baseline justify-between gap-4">
    <span class="font-mono text-sm font-medium text-accent">{p.id}</span>
    <span class="meta text-right">{p.kind[lang]}</span>
  </div>
  <h3 class="mt-1.5 text-lg font-semibold tracking-tight leading-snug transition-colors duration-150 group-hover:text-accent">
    {href ? <a href={href} class="before:absolute before:inset-0">{p.title[lang]}</a> : p.title[lang]}
  </h3>
  <p class="mt-2 line-clamp-4 text-[0.9375rem] leading-relaxed text-slate">{p.body[0]?.[lang]}</p>
  <ul class="meta mt-3 flex flex-wrap gap-x-4 gap-y-1">
    {p.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
  </ul>
</article>
