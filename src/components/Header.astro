---
import { type Lang, type RouteKey, route as routeFor, useTranslations } from "@/i18n/ui";
import { reflectionListing } from "@/lib/content";

interface Props {
  lang: Lang;
  route: RouteKey;
  paths: Record<Lang, string>;
}
const { lang, route, paths } = Astro.props;
const t = useTranslations(lang);
const home = routeFor(lang, "home");
// Reflexiones solo aparece en el menú cuando hay algo publicado.
const hasReflections = (await reflectionListing(lang)).length > 0;
const nav: { key: RouteKey; label: string }[] = [
  { key: "projects", label: t("nav.projects") },
  ...(hasReflections ? [{ key: "reflections" as const, label: t("nav.reflections") }] : []),
  { key: "album", label: t("nav.album") },
  { key: "background", label: t("nav.background") },
  { key: "about", label: t("nav.about") },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur-sm">
  <nav
    aria-label={t("nav.main")}
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-3 px-5 py-4 md:px-8"
  >
    <a href={home} aria-label={t("nav.home")} class="text-2xl font-bold tracking-tighter leading-none">
      jg<span class="text-accent">.</span>
    </a>
    <ul class="nav-row order-last flex w-full items-center justify-between gap-3 overflow-x-auto whitespace-nowrap text-[0.8125rem] sm:text-[0.9375rem] sm:order-none sm:overflow-visible sm:ml-auto sm:w-auto sm:justify-start sm:gap-7">
        {
          nav.map((item) => (
            <li>
              <a
                href={routeFor(lang, item.key)}
                aria-current={item.key === route ? "page" : undefined}
                class:list={[
                  "transition-colors duration-150 hover:text-ink",
                  item.key === route ? "text-ink" : "text-slate",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
    </ul>
    <div class="flex items-center gap-3 sm:ml-3 sm:gap-5">
      <div class="meta flex items-center gap-1.5">
        {
          (["es", "en"] as const).map((l, i) => (
            <>
              {i > 0 && <span aria-hidden="true">/</span>}
              <a
                href={paths[l]}
                hreflang={l}
                lang={l}
                aria-current={l === lang ? "true" : undefined}
                class:list={[
                  "py-1 transition-colors duration-150 hover:text-accent",
                  l === lang && "text-ink font-medium",
                ]}
              >
                {l === lang ? `[${l}]` : l}
              </a>
            </>
          ))
        }
      </div>
      <button
        type="button"
        id="theme-toggle"
        aria-label={t("theme.toggle")}
        class="grid h-8 w-8 place-items-center rounded-sm text-slate hover:text-accent transition-colors duration-150 cursor-pointer"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<style>
  /* En móvil el menú puede deslizarse si no cabe, sin mostrar barra. */
  .nav-row {
    scrollbar-width: none;
  }
  .nav-row::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const btn = document.getElementById("theme-toggle");
  btn?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    if (next === "dark") root.dataset.theme = "dark";
    else delete root.dataset.theme;
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });
</script>
