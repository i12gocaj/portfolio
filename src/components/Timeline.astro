---
import type { Lang } from "@/i18n/ui";
import { isExternal, type HistoryEntry } from "@/data/content";

interface Props {
  id: string;
  title: string;
  entries: HistoryEntry[];
  lang: Lang;
}
const { id, title, entries, lang } = Astro.props;
---

<section aria-labelledby={id} class="scroll-mt-24 pt-14 md:pt-20">
  <h2 id={id} class="meta !text-accent !text-xs mb-2">{title}</h2>
  <ol>
    {
      entries.map((e) => (
        <li class="grid gap-x-8 gap-y-1 border-t border-line py-6 md:grid-cols-[11rem_minmax(0,1fr)]">
          <p class="meta md:pt-1.5">{e.date[lang]}</p>
          <div>
            <h3 class="text-lg font-semibold tracking-tight leading-snug">{e.title[lang]}</h3>
            {e.org && <p class="mt-0.5 text-[0.9375rem] text-slate">{e.org[lang]}</p>}
            {e.body.map((b) => <p class="mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-slate">{b[lang]}</p>)}
            {e.links.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1 font-mono text-sm">
                {e.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      rel={isExternal(l.href) ? "noopener" : undefined}
                      class="text-slate underline decoration-frame underline-offset-4 transition-colors duration-150 hover:text-accent"
                    >
                      {l.label[lang]} <span aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>
