---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import profile from "@/assets/profile.jpg";
import { type Lang, route, useTranslations } from "@/i18n/ui";
import { about } from "@/data/content";
import { contact } from "@/data/home";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} route="about" title={t("about.title")} description={about[0][lang]}>
  <div class="mx-auto max-w-5xl px-5 md:px-8">
    <header class="grid items-start gap-10 pt-14 pb-24 md:grid-cols-[minmax(0,1fr)_220px] md:gap-16 md:pt-20">
      <div>
        <p class="font-mono text-sm text-slate mb-3">{t("about.title")}</p>
        <h1 class="text-4xl font-semibold tracking-tight md:text-[2.75rem]">Javier González Casares</h1>
        <div class="mt-6 max-w-xl space-y-5 text-lg leading-relaxed [&_a]:text-ink [&_a]:underline [&_a]:decoration-frame [&_a]:underline-offset-4 [&_a:hover]:text-accent">
          {about.map((p, i) => <p class={i === 0 ? "text-ink" : "text-slate"} set:html={p[lang]} />)}
        </div>
        <ul class="mt-7 flex flex-wrap gap-x-6 gap-y-2 font-mono text-sm">
          <li><a href={route(lang, "background")} class="text-ink underline decoration-frame underline-offset-4 hover:text-accent">{t("about.toBackground")} →</a></li>
          <li><a href={contact.linkedin} rel="noopener" class="text-slate hover:text-accent">LinkedIn →</a></li>
          <li><a href={contact.github} rel="noopener" class="text-slate hover:text-accent">GitHub →</a></li>
          <li><a href={`mailto:${contact.email}`} class="text-slate hover:text-accent">Email →</a></li>
        </ul>
      </div>
      <div class="frame mx-auto w-full max-w-[220px]" style="--frame-gap: 9px; --frame-size: 32px;">
        <Image src={profile} alt={t("hero.photoAlt")} widths={[220, 440]} sizes="220px" class="aspect-square w-full object-cover" />
      </div>
    </header>

  </div>
</BaseLayout>
