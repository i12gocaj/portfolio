---
/**
 * Portada. Mientras no exista la ilustración muestra un color plano con el
 * identificador de la pieza; cuando se pase `image`, la pinta encima.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  id: string;
  tone: string;
  image?: ImageMetadata;
  alt?: string;
  ratio?: "4/3" | "2/3" | "2/1";
}
const { id, tone, image, alt = "", ratio = "4/3" } = Astro.props;
---

<div class="frame" style="--frame-gap: 7px; --frame-size: 22px;">
  <div class="relative overflow-hidden rounded-xs" style={`aspect-ratio: ${ratio}; background: ${tone};`}>
    {
      image ? (
        <Image
          src={image}
          alt={alt}
          widths={[400, 800]}
          sizes="(min-width: 768px) 440px, 100vw"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      ) : (
        <span class="absolute bottom-3 left-3.5 font-mono text-xs tracking-widest text-[#25303f]/70">{id}</span>
      )
    }
  </div>
</div>
