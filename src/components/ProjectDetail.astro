---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Cover from "@/components/Cover.astro";
import Toc from "@/components/Toc.astro";
import { type Lang, route, useTranslations } from "@/i18n/ui";
import { coverOf, isExternal, projectUrl, type Project } from "@/data/content";
import { projectNote, readingMinutes } from "@/lib/content";

interface Props {
  project: Project;
  lang: Lang;
}
const { project: p, lang } = Astro.props;
const t = useTranslations(lang);
const note = await projectNote(p.slug!, lang);
const rendered = note ? await render(note) : undefined;
const Content = rendered?.Content;
const cover = coverOf(p);
const alternates = { es: projectUrl(p, "es")!, en: projectUrl(p, "en")! };
---

<BaseLayout
  lang={lang}
  route="projects"
  alternates={alternates}
  title={p.title[lang]}
  description={p.body[0]?.[lang]}
  image={cover?.src}
  article
>
  <article class="mx-auto max-w-3xl px-5 pb-24 md:px-8">
    <a href={route(lang, "projects")} class="meta mt-12 inline-block transition-colors duration-150 hover:text-accent md:mt-16">
      <span aria-hidden="true">←</span>{" "}{t("projects.back")}
    </a>

    <header class="mt-8 grid items-start gap-8 md:grid-cols-[minmax(0,1fr)_260px] md:gap-10">
      <div>
        <p class="meta flex flex-wrap gap-x-3 gap-y-1">
          <span class="!text-accent">{p.id}</span>
          <span>{p.kind[lang]}</span>
          {note && <span>{readingMinutes(note)} {t("text.min")}</span>}
          {note?.data.draft && <span class="!text-copper">[{t("text.draft")}]</span>}
        </p>
        <h1 class="mt-3 text-[2rem] font-semibold tracking-tight leading-[1.15] text-balance md:text-[2.5rem]">
          {p.title[lang]}
        </h1>
        {p.body.map((b) => <p class="mt-4 text-lg leading-relaxed text-slate">{b[lang]}</p>)}
        {p.details.map((d) => <p class="mt-4 leading-relaxed text-slate">{d[lang]}</p>)}
        <ul class="meta mt-6 flex flex-wrap gap-x-4 gap-y-1">
          {p.tags.map((tag) => <li>{tag}</li>)}
        </ul>
        {
          p.links.length > 0 && (
            <ul aria-label={t("projects.links")} class="mt-5 flex flex-wrap gap-x-6 gap-y-2 font-mono text-sm">
              {p.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    rel={isExternal(l.href) ? "noopener" : undefined}
                    class="underline decoration-frame underline-offset-4 transition-colors duration-150 hover:text-accent"
                  >
                    {l.label[lang]} <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      <div class="mx-auto w-full max-w-[260px] md:mt-2">
        <Cover tone={p.tone} image={cover} alt="" sizes="260px" eager />
      </div>
    </header>

    {
      rendered && Content && (
        <>
          <div class="mt-14">
            <Toc headings={rendered.headings} label={t("text.contents")} />
          </div>
          <div class="prose mt-10 border-t border-line pt-10">
            <Content />
          </div>
        </>
      )
    }
  </article>
</BaseLayout>
