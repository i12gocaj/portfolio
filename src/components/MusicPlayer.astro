---
/**
 * Música para acompañar la lectura: un tramo de un vídeo de YouTube en bucle,
 * manejado desde una barra propia. No carga nada de YouTube hasta que el
 * lector pulsa el botón.
 */
interface Props {
  music: { title: string; artist: string; youtube: string; start: number; end: number };
  label: string;
  play: string;
  pause: string;
}
const { music, label, play, pause } = Astro.props;
---

<div class="music" data-youtube={music.youtube} data-start={music.start} data-end={music.end}>
  <button type="button" class="music-button" aria-pressed="false" aria-label={`${play}: ${music.title}, ${music.artist}`} data-play={play} data-pause={pause}>
    <svg class="icon-play" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.5v11l9-5.5z" fill="currentColor"></path></svg>
    <svg class="icon-pause" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 2h3v10H3zM8 2h3v10H8z" fill="currentColor"></path></svg>
  </button>
  <div class="min-w-0 flex-1">
    <p class="flex flex-wrap items-baseline gap-x-2 text-[0.9375rem] leading-snug">
      <span class="meta">{label}</span>
      <span class="font-semibold">{music.title}</span>
      <span class="text-slate">{music.artist}</span>
    </p>
    <div class="music-track" aria-hidden="true"><div class="music-progress"></div></div>
  </div>
  <div class="music-frame" aria-hidden="true"><div class="music-target"></div></div>
</div>

<style>
  .music {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    max-width: 26rem;
  }
  .music-button {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .music-button:hover,
  .music-button[aria-pressed="true"] {
    background: var(--accent);
  }
  .icon-pause,
  .music-button[aria-pressed="true"] .icon-play {
    display: none;
  }
  .music-button[aria-pressed="true"] .icon-pause {
    display: block;
  }
  .music-track {
    margin-top: 0.5rem;
    height: 2px;
    background: var(--line);
  }
  .music-progress {
    width: 0;
    height: 100%;
    background: var(--accent);
  }
  /* El reproductor de YouTube solo aporta el sonido; la barra es el control. */
  .music-frame {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  declare global {
    interface Window {
      YT?: any;
      onYouTubeIframeAPIReady?: () => void;
    }
  }

  let apiReady: Promise<void> | undefined;
  function loadApi(): Promise<void> {
    apiReady ??= new Promise((resolve) => {
      if (window.YT?.Player) return resolve();
      const previous = window.onYouTubeIframeAPIReady;
      window.onYouTubeIframeAPIReady = () => {
        previous?.();
        resolve();
      };
      const script = document.createElement("script");
      script.src = "https://www.youtube.com/iframe_api";
      document.head.append(script);
    });
    return apiReady;
  }

  document.querySelectorAll<HTMLElement>(".music").forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>(".music-button")!;
    const target = root.querySelector<HTMLElement>(".music-target")!;
    const progress = root.querySelector<HTMLElement>(".music-progress")!;
    const start = Number(root.dataset.start);
    const end = Number(root.dataset.end);
    let player: any;
    let timer: number | undefined;

    const setPlaying = (playing: boolean) => button.setAttribute("aria-pressed", String(playing));

    // Mueve la barra y vuelve al inicio del tramo en cuanto se alcanza el final.
    const watch = () => {
      window.clearInterval(timer);
      timer = window.setInterval(() => {
        const now = player?.getCurrentTime?.();
        if (typeof now !== "number") return;
        if (now >= end || now < start - 1) {
          player.seekTo(start, true);
          return;
        }
        const done = Math.min(1, Math.max(0, (now - start) / (end - start)));
        progress.style.width = `${done * 100}%`;
      }, 200);
    };

    button.addEventListener("click", async () => {
      if (player) {
        const state = player.getPlayerState?.();
        if (state === window.YT.PlayerState.PLAYING) player.pauseVideo();
        else player.playVideo();
        return;
      }
      await loadApi();
      player = new window.YT.Player(target, {
        host: "https://www.youtube-nocookie.com",
        width: 200,
        height: 200,
        videoId: root.dataset.youtube,
        playerVars: { start: Math.floor(start), autoplay: 1, controls: 0, playsinline: 1, rel: 0 },
        events: {
          onReady: (event: any) => {
            event.target.seekTo(start, true);
            event.target.playVideo();
            watch();
          },
          // Si el vídeo no permite incrustarse, se abre en YouTube.
          onError: () => {
            window.clearInterval(timer);
            setPlaying(false);
            window.open(`https://www.youtube.com/watch?v=${root.dataset.youtube}&t=${Math.floor(start)}s`, "_blank", "noopener");
          },
          onStateChange: (event: any) => {
            const S = window.YT.PlayerState;
            if (event.data === S.ENDED) {
              event.target.seekTo(start, true);
              event.target.playVideo();
            }
            setPlaying(event.data === S.PLAYING || event.data === S.BUFFERING);
          },
        },
      });
    });
  });
</script>
