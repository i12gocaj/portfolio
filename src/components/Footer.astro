---
import { type Lang, useTranslations } from "@/i18n/ui";
import { contact } from "@/data/home";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const links = [
  { href: contact.github, label: "GitHub" },
  { href: contact.linkedin, label: "LinkedIn" },
  { href: contact.oldSite, label: t("footer.oldSite") },
];
---

<footer class="border-t border-line">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-3 px-5 py-8 text-sm text-slate sm:flex-row sm:items-center sm:justify-between md:px-8"
  >
    <p>© {new Date().getFullYear()} Javier González Casares</p>
    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      {
        links.map((l) => (
          <li>
            <a href={l.href} rel="noopener" class="hover:text-ink transition-colors duration-150">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
