---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout lang="es" title="404" path="/">
  <div class="mx-auto max-w-5xl px-5 py-28 md:px-8">
    <p class="meta !text-accent">Error 404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">Esta página no existe.</h1>
    <p class="mt-4 text-slate">
      <a href="/" class="underline decoration-frame underline-offset-4 hover:text-accent">Volver al inicio</a>
      ·
      <a href="/en/" lang="en" class="underline decoration-frame underline-offset-4 hover:text-accent">Back to home</a>
    </p>
  </div>
</BaseLayout>
