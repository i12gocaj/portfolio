{
  // Cloudflare Workers con assets estaticos: sirve la carpeta dist tal cual.
  "name": "javiergc-es",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Dominios propios: wrangler crea el DNS y el certificado al desplegar.
  "routes": [
    { "pattern": "javiergc.es", "custom_domain": true },
    { "pattern": "www.javiergc.es", "custom_domain": true }
  ]
}
